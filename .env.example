# Control plane
DATABASE_URL=postgres://swarm:swarm@localhost:5432/swarm
AUTH_SECRET=change-me-32-bytes-min
APP_URL=http://localhost:3000

# Шифрование секретов тенантов и Google token в PostgreSQL (32 байта, base64)
SECRETS_KEY=

# Модели
OPENROUTER_API_KEY=

# Fly.io: машины агентов
FLY_API_TOKEN=
FLY_ORG=personal
FLY_REGION=ams
FLY_AGENTS_APP=swarm-agents
AGENT_RUNTIME_IMAGE=registry.fly.io/swarm-agent-runtime:latest
HERMES_IMAGE=nousresearch/hermes-agent:latest

# Почта
MAILGUN_API_KEY=
MAILGUN_SIGNING_KEY=
MAILGUN_REGION=eu
AGENTS_DOMAIN=agents.example.com
WEBHOOK_URL=https://app.example.com/webhooks/email
# Нужен только для JSON-входа (Postmark и т.п.)
INBOUND_WEBHOOK_TOKEN=

# Разработка: адрес локального runtime вместо приватного .internal у Fly
# DEV_RUNTIME_URL=http://localhost:8787

# Браузер
# Skyvern — регистрация по приглашению и обход капчи. Работа внутри сервиса идёт своим Chromium на машине агента.
SKYVERN_API_KEY=

# Google OAuth (Web client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Slack OAuth. Request URL приложения: {APP_URL}/webhooks/slack
# События бота: message.im, app_mention, app_uninstalled. Redirect: {APP_URL}/api/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
